# 开发环境配置（react-scripts 启动时读取）
# API 基址留空 → 相对路径，由 package.json 的 "proxy" 转发到后端，避免跨域。
# 后端开发地址见对接文档：http://localhost:8989
REACT_APP_API_BASE=

# 开启 proxy 后，react-scripts 5 计算 allowedHosts 存在已知 bug
# （"allowedHosts[0] should be a non-empty string"）。
# 关闭 dev-server 的 host 校验即可（allowedHosts='all'），仅影响本地开发服务器，
# 不影响生产构建。等价于未配 proxy 时的默认行为。
DANGEROUSLY_DISABLE_HOST_CHECK=true
