# 本地真实配置示例 —— 复制为 application-local.yml 后填入真实值
# application-local.yml 已被 .gitignore 忽略，不会进仓库（密钥隔离）
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/mile_toolbox?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: your_db_user
    password: your_db_password
  data:
    redis:
      host: localhost
      port: 6379
      password: your_redis_password

# 维智地图 SDK（经纬度/地理编码 geocode 工具用）
toolbox:
  wayz:
    app-key: your_wayz_app_key
  # 接口盒子 apihz.cn（手机号归属地 phone-location）：
  # 默认公共测试号 88888888 有频次限制；生产请到 apihz.cn 注册专属 id/key
  apihz:
    id: "88888888"
    key: "88888888"
  # 腾讯云 COS 对象存储（文件处理产物保留/分享）。密钥仅存本地，不进仓库。
  cos:
    enabled: false
    region: ap-guangzhou
    bucket: your_bucket
    secret-id: your_secret_id
    secret-key: your_secret_key
    prefix: toolbox/
  # 文档转换 Pandoc（doc-convert）。服务器需安装 pandoc，见 docs/部署-宝塔外部依赖安装.md
  pandoc:
    enabled: false
    path: pandoc
    timeout-seconds: 60
